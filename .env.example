# Copier en .env.local. Rien de rempli ici : chaque valeur se décide au call avec le client.

# URL publique du site (liens dans les e-mails et les PDF)
SITE_URL=http://localhost:3000

# E-mails des comptes qui ont accès à /gestion, séparés par des virgules
ADMIN_EMAILS=

# Adresse qui reçoit les nouvelles demandes et les messages du formulaire de contact
STUDIO_EMAIL=studio360@gmail.com

# Base de données. Vide : Postgres embarqué (PGlite) dans ./data/pglite, pour le travail local.
# Production : une URL Postgres (Supabase, Neon...). Voir README, partie "Mise en ligne".
DATABASE_URL=

# E-mails. Vide : les e-mails sont écrits dans ./.outbox et lisibles sur /dev/boite.
RESEND_API_KEY=
MAIL_FROM=

# Connexion Google (facultatif). Vide : le bouton Google n'apparaît pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paiement en ligne : aucun pour l'instant, rien à régler ici (voir README, « Paiement »).
